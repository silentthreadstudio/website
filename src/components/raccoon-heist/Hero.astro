---
// Dusk. The heist begins: dark room -> rat eyes blink on -> spotlight clicks on -> Rocco drops in ->
// the Rat Mob leans in -> coins fall. The teaser layers stack at one integer scale (--s), never resized
// per layer, so every pixel matches. Without JS or with reduced motion this is the composed final frame.
import { LOGLINE } from './data';

const layers = ['background', 'eyes', 'rats-left', 'rats-right', 'rocco'];
---

<section class="hero" aria-labelledby="rh-title" data-hero>
  <div class="hero-stage" data-hero-stage>
    <div
      class="hero-art"
      role="img"
      aria-label="Concept art: Rocco the raccoon strikes a pose under a spotlight in a dark casino, a playing card in one paw and a coin pouch on his belt, while Don Vermino's Rat Mob and dozens of glowing eyes close in."
    >
      {layers.map((id) => (
        <img
          src={`/raccoon-heist/${id}.webp`}
          alt=""
          width="688"
          height="384"
          loading="eager"
          decoding="async"
          fetchpriority={id === 'background' ? 'high' : 'auto'}
          class={`hl hl-${id}`}
          data-layer={id}
        />
      ))}
      <div class="hero-rain" data-hero-rain aria-hidden="true"></div>
    </div>
    <p class="hero-cap">Concept art</p>
  </div>

  <div class="hero-sign" data-hero-sign>
    <p class="rh-kicker hero-kicker">A Silent Thread game</p>
    <h1 id="rh-title" class="marquee" data-marquee>
      <span class="marquee-text">Raccoon <span class="marquee-br" aria-hidden="true"></span>Heist</span>
    </h1>
  </div>

  <div class="hero-copy" data-hero-copy>
    <p class="hero-line">{LOGLINE}</p>
    <div class="hero-cta">
      <span class="chip chip-gold">Coming to Steam</span>
      <a class="link-pixel hero-start" href="#catch">Start the night <span aria-hidden="true">&darr;</span></a>
    </div>
  </div>
</section>

<style>
  .hero {
    --s: 1;
    position: relative; padding-top: var(--header-h);
    /* Dusk: a crimson-and-violet horizon under the casino. */
    background:
      radial-gradient(120% 60% at 50% 100%, rgb(155 35 53 / 0.55), transparent 70%),
      linear-gradient(to bottom, #07040F, var(--ink) 55%, #24152F);
  }
  @media (min-width: 1100px) and (min-height: 640px) { .hero { --s: 2; } }
  @media (min-width: 2100px) and (min-height: 1100px) { .hero { --s: 3; } }

  .hero-stage {
    position: relative; overflow: hidden; background: #07040F;
    height: calc(384px * var(--s));
  }
  @media (min-width: 1100px) and (min-height: 640px) {
    .hero-stage { height: clamp(560px, calc(100svh - var(--header-h)), calc(384px * var(--s))); }
  }
  .hero-art {
    position: absolute; left: 50%; bottom: 0;
    width: calc(688px * var(--s)); height: calc(384px * var(--s));
    transform: translateX(-50%); overflow: hidden;
  }
  .hl {
    position: absolute; inset: 0; width: 100%; height: 100%; max-width: none;
    image-rendering: pixelated; user-select: none; pointer-events: none;
  }
  /* The Rat Mob stands back from Rocco by whole art pixels, so the pixel grid stays intact. */
  .hl-rats-left { left: calc(-44px * var(--s)); }
  .hl-rats-right { left: calc(44px * var(--s)); }
  /* The art's dark edges melt into the stage on wide screens. */
  .hero-art::after {
    content: ''; position: absolute; inset: 0; pointer-events: none; z-index: 3;
    background:
      linear-gradient(to right, #07040F, transparent 6%, transparent 94%, #07040F),
      linear-gradient(to top, var(--ink) 0, rgb(20 16 31 / 0.85) 16%, transparent 38%),
      linear-gradient(to bottom, rgb(7 4 15 / 0.7), transparent 22%);
  }
  .hero-rain { position: absolute; inset: 0; pointer-events: none; overflow: hidden; z-index: 2; }
  .hero-cap {
    position: absolute; right: var(--side-r); top: 14px; margin: 0; z-index: 4;
    font: 400 0.7rem/1 var(--pixel); text-transform: uppercase; letter-spacing: 0.06em;
    color: var(--text); background: rgb(20 16 31 / 0.8); padding: 6px 8px; border: 2px solid var(--ink);
  }

  /* Mobile: the sign and the copy follow the stage. Desktop: the sign hangs from the ceiling over the
     spotlight and the copy sits on the floor, so Rocco stays the focal point between them. */
  .hero-sign, .hero-copy {
    position: relative; z-index: 5;
    display: grid; justify-items: center; text-align: center; gap: 12px;
    padding: 0 var(--side-r) 0 var(--side-l);
  }
  .hero-sign { margin-top: -40px; }
  .hero-copy { padding-top: 18px; padding-bottom: clamp(40px, 7vh, 72px); }
  @media (min-width: 1100px) and (min-height: 640px) {
    .hero-sign { position: absolute; left: 0; right: 0; top: calc(var(--header-h) + 18px); margin: 0; }
    .hero-copy { position: absolute; left: 0; right: 0; bottom: 0; padding-bottom: clamp(24px, 4vh, 44px); }
    /* The cast stands a little lower so the sign clears their heads. */
    .hero-art { bottom: calc(-36px * var(--s)); }
  }

  /* The title as a casino marquee: crimson board, chasing bulbs, gold letters with a hard extrude. */
  .marquee {
    position: relative; margin: 0; padding: clamp(14px, 2vw, 24px) clamp(20px, 3vw, 40px);
    background: var(--crim-d); border: 2px solid var(--ink);
    box-shadow: inset 0 0 0 4px var(--gold-d), inset 0 0 0 6px var(--ink), 8px 8px 0 var(--ink);
  }
  .marquee::before, .marquee::after {
    content: ''; position: absolute; inset: 10px; pointer-events: none;
    padding: 6px;
    background: radial-gradient(circle, var(--gold-l) 0 2.5px, rgb(255 233 160 / 0.25) 3px, transparent 3.5px) 0 0 / 16px 16px;
    -webkit-mask: linear-gradient(#000 0 0) content-box exclude, linear-gradient(#000 0 0);
    mask: linear-gradient(#000 0 0) content-box exclude, linear-gradient(#000 0 0);
  }
  .marquee::after { background-position: 8px 8px; opacity: 0.35; }
  @media (prefers-reduced-motion: no-preference) {
    .marquee::before { animation: bulbs 0.9s steps(1) infinite; }
    .marquee::after { animation: bulbs 0.9s steps(1) infinite reverse; }
  }
  @keyframes bulbs { 0% { opacity: 1; } 50% { opacity: 0.35; } }
  .marquee-text {
    display: block; position: relative;
    font: 700 clamp(2.4rem, 4.6vw, 4.6rem)/0.95 var(--pixel); text-transform: uppercase; letter-spacing: 0.01em;
    color: var(--gold-l);
    text-shadow: 0.04em 0.04em 0 var(--gold-d), 0.08em 0.08em 0 var(--ink);
    white-space: nowrap;
  }
  .marquee-br { display: none; }
  @media (max-width: 599px) { .marquee-br { display: block; } }

  .hero-line {
    margin: 0; max-width: 62ch;
    font: 600 clamp(1.05rem, 1.6vw, 1.35rem)/1.4 var(--font-body); color: var(--text);
    text-shadow: 2px 2px 0 var(--ink); text-wrap: balance;
  }
  .hero-cta { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 10px 22px; }
  .hero-start { color: var(--gold-l); }
  .hero-kicker { text-shadow: 2px 2px 0 var(--ink); }

  /* Particles created by the opening (coins and cards falling into the light). */
  .hero-rain :global(.drop) {
    position: absolute; top: 0; background-repeat: no-repeat; image-rendering: pixelated; will-change: transform;
  }
</style>
