---
// Grow the casino (planned): from one dingy room to a grand casino, room by room.
// Tiles use the game's skill-tree states: locked = line border, owned = gold border + gold link.
// Each room is a crop of the teaser room at 1x; as you scroll they "get built" in order.
import Px from './Px.astro';
import { ROOMS } from './data';
---

<section id="grow" class="rh-sec grow" aria-labelledby="grow-title">
  <div class="rh-wrap">
    <div class="rh-head">
      <p class="rh-kicker">5 AM, between nights</p>
      <div class="rh-head-row">
        <h2 id="grow-title" class="rh-h2">Grow the casino</h2>
        <span class="chip chip-dim">Planned</span>
      </div>
      <p class="rh-lede">You start with one dingy room. Between nights you spend gold on new ones, and every room you build stays, even when the Boss takes the deed back. The rats never renovate.</p>
    </div>

    <ol class="rooms" data-rooms>
      {ROOMS.map((r, i) => (
        <li class:list={['room', { 'room-start': r.start }]} data-room data-built={r.start ? 'true' : undefined} style={`--i:${i}`}>
          <span class="room-art" aria-hidden="true" style={r.crop ? `--cx:${r.crop[0] * 100}%;--cy:${r.crop[1] * 100}%` : undefined}>
            {r.vault && <Px sheet="lockbox" frame={4} class="vault-box" />}
            {r.start && <span class="room-here">Start</span>}
          </span>
          <span class="room-name">{r.name}</span>
          <span class="room-adds">{r.adds}</span>
        </li>
      ))}
    </ol>
    <p class="grow-foot">Every new room adds a door. More doors, more rats. More rats, more coins.</p>
  </div>
</section>

<style>
  .grow { background: linear-gradient(to bottom, var(--night), #2B2747 70%, #3d2a4f); }
  .rooms {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: clamp(14px, 1.8vw, 24px);
  }
  .room { position: relative; display: grid; gap: 8px; align-content: start; }
  /* Links between rooms, like the skill tree: locked line, owned gold. */
  .room:not(:last-child)::after {
    content: ''; position: absolute; top: calc(var(--art-h) / 2); left: 100%; width: clamp(14px, 1.8vw, 24px); height: 2px;
    background: var(--line-g);
  }
  .room[data-built='true']:not(:last-child)::after { height: 4px; margin-top: -1px; background: var(--gold); }
  .rooms { --art-h: clamp(110px, 10vw, 150px); }
  .room-art {
    position: relative; display: grid; place-items: center; height: var(--art-h); overflow: hidden;
    background: url('/raccoon-heist/background.webp') var(--cx, 50%) var(--cy, 50%) / 688px 384px no-repeat, var(--ink);
    image-rendering: pixelated;
    border: 2px dashed var(--line-g); box-shadow: 4px 4px 0 var(--ink);
    filter: grayscale(1) brightness(0.45);
    transition: filter 0.4s steps(4), border-color 0.4s steps(2);
  }
  /* Built rooms get grander down the line: each a little brighter and warmer than the last. */
  .room[data-built='true'] .room-art {
    border: 2px solid var(--ink); box-shadow: inset 0 0 0 3px var(--gold), 4px 4px 0 var(--ink), 0 0 calc(var(--i) * 5px) rgb(255 201 60 / 0.25);
    filter: brightness(calc(0.8 + var(--i) * 0.07)) saturate(calc(0.75 + var(--i) * 0.08));
  }
  /* The lobby is the dump you start in: lit, but dingy. */
  .room-start .room-art, :global(html) .room-start[data-built='true'] .room-art { filter: saturate(0.55) brightness(0.75); }
  .room-here {
    position: absolute; left: 6px; top: 6px; font: 700 0.65rem/1 var(--pixel); text-transform: uppercase;
    background: var(--gold); color: var(--ink); padding: 5px 6px; border: 2px solid var(--ink);
  }
  .vault-box { position: relative; }
  .room-art:has(.vault-box) {
    background: repeating-linear-gradient(0deg, #2B2747 0 18px, #24203d 18px 20px), var(--slate);
  }
  .room-name { font: 700 0.85rem/1.2 var(--pixel); text-transform: uppercase; color: var(--text-dim); }
  .room[data-built='true'] .room-name { color: var(--gold-l); }
  .room-adds { font-size: 0.9rem; line-height: 1.4; color: var(--text-dim); }
  .grow-foot { margin: 2.2rem 0 0; font: 700 clamp(0.9rem, 1.4vw, 1.1rem)/1.5 var(--pixel); color: var(--text); max-width: 60ch; }

  /* Without JS (or with reduced motion), the casino is already grown. */
  :global(html:not(.js-motion)) .room .room-art { border: 2px solid var(--ink); box-shadow: inset 0 0 0 3px var(--gold), 4px 4px 0 var(--ink); filter: brightness(calc(0.8 + var(--i) * 0.07)) saturate(calc(0.75 + var(--i) * 0.08)); }
  :global(html:not(.js-motion)) .room .room-name { color: var(--gold-l); }
  :global(html:not(.js-motion)) .room:not(:last-child)::after { height: 4px; background: var(--gold); }

  @media (max-width: 1100px) {
    .rooms { grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); }
    .room::after { display: none; }
  }
</style>
