---
// Kit sends subscribers here once they click the confirmation link.
import Base from '../layouts/Base.astro';
import ErrorPage from '../components/ErrorPage.astro';
---

<Base title="You're on the list | Silent Thread" description="Your subscription to news from Silent Thread is confirmed." noindex>
  <ErrorPage
    label="Newsletter"
    title="You're on the list."
    links={[
      { label: 'Back to the studio', href: '/' },
      { label: 'Raccoon Heist', href: '/games/raccoon-heist' },
      { label: 'Follow @silentthreadhq', href: 'https://x.com/silentthreadhq' },
    ]}
  >
    <p>Confirmed. News from the studio will reach you when there is news. Every email has an unsubscribe link at the bottom.</p>
  </ErrorPage>
</Base>
