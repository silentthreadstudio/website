---
import Base from '../layouts/Base.astro';
import HeistScene from '../components/HeistScene.astro';
import tile from '../assets/tile.svg?raw';
import { FOUNDER, GAME, LAB, NOW, ORIGIN, ROAD } from '../data/home';
import { lastPublicPush } from '../lib/github';
import { founder } from '../lib/schema';
import { ROAD_ICONS } from '../data/road-icons';
import { CONTACT_EMAIL, NEWSLETTER_ENDPOINT, SOCIAL, TIMEZONE } from '../site';

const push = await lastPublicPush();
const pushAt = push
  ? new Intl.DateTimeFormat('en-GB', {
      timeZone: TIMEZONE, day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit', hour12: false,
    }).format(push.at)
  : null;
---

<Base schema={[founder()]}>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <span class="hero-thread" aria-hidden="true"><span class="hero-dot"></span></span>
      <p class="label hero-label">Game studio and Lab / Colombia</p>
      <h1 id="hero-title" class="hero-title">
        <span class="hero-line">Quiet name.</span>
        <span class="hero-line">Loud worlds.</span>
      </h1>
      <p class="hero-lede">Silent Thread is a game studio from Colombia. It started as the work I did after hours.</p>
      <p class="hero-links">
        <a class="link" href="#founder">Meet the founder</a>
        <a class="link" href="https://x.com/silentthreadhq" rel="me noopener">Follow on X <span aria-hidden="true">↗</span></a>
      </p>
    </div>
  </section>

  <section id="origin" class="section origin" aria-labelledby="origin-title">
    <div class="origin-copy">
      <div class="sec-head">
        <p class="label sec-label" style="--drop:16vh" data-sec><span class="sec-thread" aria-hidden="true"></span>01 / Origin</p>
        <h2 id="origin-title" class="h2" data-reveal>Made after hours.</h2>
      </div>
      <div class="origin-lines" data-reveal-group>
        {ORIGIN.map((line) => <p>{line}</p>)}
      </div>
    </div>
    <figure class="origin-mark">
      <div class="mark-tile" set:html={tile} aria-hidden="true" />
      <figcaption class="label">The mark: one line ending in a weight</figcaption>
    </figure>
  </section>

  <section id="founder" class="section founder" aria-labelledby="founder-title">
    <div class="founder-portrait">
      <span class="portrait-thread" aria-hidden="true"></span>
      <img src="/founder/portrait-512.webp" width="512" height="512" alt="Pixel-art portrait of Esteban Estrada: backwards cap, glasses, beard." loading="lazy" decoding="async" />
    </div>
    <div class="founder-copy">
      <p class="label sec-label" style="--drop:16vh" data-sec><span class="sec-thread" aria-hidden="true"></span>02 / The founder</p>
      <p class="founder-name" data-reveal>{FOUNDER.name} <span>{FOUNDER.title}</span></p>
      <h2 id="founder-title" class="h2 founder-headline" data-reveal>{FOUNDER.headline}</h2>
      <div class="prose" data-reveal-group>
        {FOUNDER.bio.map((p) => <p>{p}</p>)}
      </div>
      <blockquote class="quote" data-reveal><p>“{FOUNDER.quote}”</p></blockquote>
      <ul class="facts" data-reveal-group>
        {FOUNDER.facts.map((f) => <li>{f}</li>)}
      </ul>
      <p class="founder-links">
        {FOUNDER.links.map((l) => <a class="link" href={l.href} rel="me noopener">{l.label} <span aria-hidden="true">↗</span></a>)}
      </p>
    </div>
  </section>

  <section id="work" class="section work" aria-labelledby="work-title">
    <div class="sec-head">
      <p class="label sec-label" style="--drop:16vh" data-sec><span class="sec-thread" aria-hidden="true"></span>03 / The work</p>
      <h2 id="work-title" class="h2" data-reveal>Games, and the Lab next to them.</h2>
    </div>

    <a class="game-card" href={GAME.href} data-reveal>
      <HeistScene />
      <span class="game-text">
        <span class="label">Games / First</span>
        <span class="game-title">{GAME.title}</span>
        <span class="game-line">{GAME.line}</span>
        <span class="game-foot"><span class="status-dot" aria-hidden="true"></span>{GAME.status}<span class="game-go">Enter the casino <span aria-hidden="true">→</span></span></span>
      </span>
    </a>

    <div class="lab">
      <div class="lab-head" data-reveal>
        <span class="label">The Lab</span>
        <h3 class="h3">Tools for AI coding agents.</h3>
      </div>
      <p class="lab-film" data-reveal>{LAB.highlight}</p>
      <ul class="lab-grid" data-reveal-group>
        {LAB.tools.map((t) => (
          <li><a class="lab-card" href={t.href} rel="noopener"><span class="tool-name">{t.name} <span aria-hidden="true">↗</span></span><span class="tool-line">{t.line}</span></a></li>
        ))}
      </ul>
    </div>
  </section>

  <section id="road" class="section road band-surface" aria-labelledby="road-title">
    <div class="road-main">
      <div class="sec-head">
        <p class="label sec-label" style="--drop:16vh" data-sec><span class="sec-thread" aria-hidden="true"></span>04 / The road so far</p>
        <h2 id="road-title" class="h2" data-reveal>The road so far.</h2>
      </div>
      <div class="road-track" data-road>
        <span class="road-rail" aria-hidden="true"></span>
        <span class="road-line" aria-hidden="true"></span>
        <ol class="road-list">
          {ROAD.map((r, i) => (
            <li class:list={['road-beat', { now: i === ROAD.length - 1 }]} data-beat data-when={r.when}>
              <span class="road-dot" aria-hidden="true"></span>
              <span class="road-when">{r.when}</span>
              <p class="road-what">{r.beat}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
    <aside class="road-aside" aria-hidden="true">
      <div class="road-now">
        <span class="label">On the thread</span>
        <span class="road-year" data-road-year>{ROAD[ROAD.length - 1].when}</span>
        <span class="road-icons" data-road-icons>
          {ROAD.map((r, i) => (
            <svg class:list={['road-icon', { on: i === ROAD.length - 1 }]} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" set:html={ROAD_ICONS[r.icon]} />
          ))}
        </span>
      </div>
    </aside>
  </section>

  <section id="now" class="section now" aria-labelledby="now-title">
    <div class="sec-head">
      <p class="label sec-label" style="--drop:16vh" data-sec><span class="sec-thread" aria-hidden="true"></span>05 / Night shift</p>
      <h2 id="now-title" class="h2" data-reveal>Night shift.</h2>
    </div>
    <dl class="now-panel" data-reveal-group>
      <div><dt>Currently building</dt><dd><a href={GAME.href}>{NOW.building}</a></dd></div>
      {push && pushAt && (
        <div><dt>Last public commit</dt><dd>{pushAt} <span class="muted">Medellín time ·</span> <a class="muted" href={`https://github.com/${push.repo}`} rel="noopener">{push.repo}</a></dd></div>
      )}
      <div><dt>In Medellín</dt><dd><span class="clock" data-clock data-tz={TIMEZONE}>--:--</span> <span class="shift" data-shift></span></dd></div>
    </dl>
  </section>

  <section id="contact" class="section contact" aria-labelledby="contact-title">
    <div class="contact-main">
      <p class="label sec-label" style="--drop:16vh" data-sec><span class="sec-thread" aria-hidden="true"></span>06 / Contact</p>
      <h2 id="contact-title" class="h2" data-reveal>Hear it first.</h2>
      {NEWSLETTER_ENDPOINT ? (
        <form class="signup" action={NEWSLETTER_ENDPOINT} method="post">
          <label for="signup-email">Email</label>
          <div class="signup-row">
            <input id="signup-email" name="email" type="email" required autocomplete="email" placeholder="you@example.com" />
            <button type="submit">Subscribe</button>
          </div>
          <p class="fine">News from the studio. No spam, unsubscribe any time.</p>
        </form>
      ) : (
        <p class="contact-lede">News from the studio goes out on X first.<br /><a class="link" href="https://x.com/silentthreadhq" rel="me noopener">Follow @silentthreadhq <span aria-hidden="true">↗</span></a></p>
      )}
    </div>
    <dl class="contact-list" data-reveal-group>
      <div><dt>Email</dt><dd><a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></dd></div>
      {SOCIAL.map((s) => (
        <div><dt>{s.label.split(' ')[0]}</dt><dd><a href={s.href} rel="me noopener">{s.label.split(' ').slice(1).join(' ') || s.href.replace('https://', '')}</a></dd></div>
      ))}
      <div><dt>Press</dt><dd><a href="/press">Press kit</a></dd></div>
    </dl>
  </section>
</Base>

<script>
  import { initMotion, initClock } from '../scripts/motion';
  initClock();
  initMotion();
</script>

<style>
  /* ---------- Hero: the thread hangs from the top edge onto the headline ---------- */
  .hero {
    position: relative; overflow: hidden; min-height: 92svh; display: grid; align-items: end;
    padding: calc(var(--header-h) + 8vh) var(--side-r) 12vh var(--side-l);
  }
  /* Sits exactly under the I of the header wordmark: the logo's thread pays out onto the page.
     Tall enough to always reach the top edge; the hero clips it there. */
  .hero-thread {
    position: absolute; left: calc(var(--mark-w) * 0.0953); bottom: calc(100% + 22px); width: 2px; height: 200vh; margin-left: -1px;
    background: var(--fg);
  }
  .hero-dot {
    position: absolute; left: 50%; bottom: 0; width: 14px; height: 14px; margin: 0 0 -7px -7px;
    border-radius: 50%; background: var(--signal);
  }
  .hero-copy { position: relative; display: grid; gap: 1.4rem; }
  .hero-title {
    margin: 0; display: grid;
    font: 800 clamp(2.3rem, 8.2vw, 9rem)/0.9 var(--font-display); font-stretch: 125%;
    text-transform: uppercase; letter-spacing: -0.02em;
  }
  .hero-lede { margin: 0.4rem 0 0; max-width: 44ch; font-size: clamp(1.05rem, 1.5vw, 1.3rem); color: var(--fg-3); }
  .hero-links { margin: 0.6rem 0 0; display: flex; flex-wrap: wrap; gap: 0.8rem 2rem; }

  /* First-visit sting: line pays out, weight lands with a 2-frame lime flash, words follow. */
  :global(html.sting) .hero-thread { animation: pay-out 0.7s var(--motion-ease) 0.5s backwards; }
  :global(html.sting) .hero-dot { animation: land 0.26s ease-out 1.2s backwards, flash 33ms steps(1) 1.2s; }
  /* Only the thread and the two lines animate; label, lede and links are readable from the first frame. */
  :global(html.sting) .hero-line { animation: rise 0.9s var(--motion-ease) backwards; }
  :global(html.sting) .hero-line:first-child { animation-delay: 1.5s; }
  :global(html.sting) .hero-line:last-child { animation-delay: 2.2s; }
  @keyframes pay-out { from { transform: translateY(-100%); } to { transform: none; } }
  @keyframes land { 0% { translate: 0 0; } 35% { translate: 0 5px; } 100% { translate: 0 0; } }
  @keyframes flash { from, to { background: var(--signal); } }
  @keyframes rise { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }

  /* ---------- Origin: copy left, the mark draws itself on the right ---------- */
  .origin { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: 3rem 6vw; align-items: center; }
  .origin-lines { display: grid; gap: 0.3rem; font: 600 clamp(1.3rem, 2.6vw, 2.2rem)/1.3 var(--font-display); font-stretch: 108%; max-width: 34ch; }
  .origin-lines p { margin: 0; color: var(--fg); }
  .origin-lines p:not(:last-child) { color: var(--fg-2); }
  .origin-mark { margin: 0; display: grid; gap: 1rem; justify-items: center; }
  .mark-tile { width: min(100%, 300px); aspect-ratio: 1; border: 1px solid var(--surface); border-radius: 14%; overflow: hidden; }
  .mark-tile :global(svg) { display: block; width: 100%; height: 100%; }

  /* ---------- Founder: the portrait hangs from the section rule and stays while the bio scrolls ---------- */
  .founder { display: grid; grid-template-columns: minmax(0, 512px) minmax(0, 1fr); gap: 3rem 5vw; align-items: start; }
  .founder-portrait { position: sticky; top: calc(var(--header-h) + 4vh); padding-top: 6vh; }
  .portrait-thread { position: absolute; left: 50%; top: -16vh; height: calc(16vh + 6vh); width: 1px; background: var(--fg); }
  .founder-portrait img {
    /* 4x source of a 128 px true-pixel portrait: shown at 1x, or a whole step down on phones. */
    position: relative; width: 512px; max-width: 100%; height: auto; aspect-ratio: 1;
    image-rendering: pixelated; border: 1px solid var(--surface); background: var(--bg);
  }
  .founder-copy { display: grid; gap: 1.6rem; max-width: 46rem; }
  .founder-name {
    margin: 0; display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.4rem 1rem;
    font: 700 1.15rem var(--font-display); font-stretch: 118%; text-transform: uppercase; letter-spacing: 0.04em;
  }
  .founder-name span { font: 600 0.72rem var(--font-mono); letter-spacing: 0.2em; color: var(--fg-3); }
  .founder-headline { font-size: clamp(2rem, 4.4vw, 4.2rem); }
  .founder .prose p:last-child { margin-bottom: 0; }
  .quote { margin: 0.6rem 0; padding: 1.4rem 1.6rem; background: var(--surface); border-left: 2px solid var(--fg); }
  .quote p { margin: 0; color: var(--fg); font: 700 clamp(1.25rem, 2.1vw, 1.7rem)/1.3 var(--font-display); font-stretch: 110%; text-wrap: balance; }
  .facts { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 1px; background: var(--surface); border: 1px solid var(--surface); }
  .facts li { padding: 16px; background: var(--bg); font: 600 0.72rem/1.4 var(--font-mono); letter-spacing: 0.12em; text-transform: uppercase; }
  .founder-links { margin: 0; display: flex; flex-wrap: wrap; gap: 0.8rem 2rem; }

  /* ---------- Work: the colour lives here ---------- */
  .game-card {
    display: grid; grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr); align-items: end;
    background: var(--surface); border: 1px solid var(--surface); text-decoration: none;
  }
  .game-card :global(.heist) { min-width: 0; }
  .game-text { display: grid; gap: 1rem; padding: clamp(1.4rem, 3vw, 2.6rem); align-content: end; }
  .game-title { font: 800 clamp(2rem, 4vw, 3.8rem)/0.95 var(--font-display); font-stretch: 125%; text-transform: uppercase; letter-spacing: -0.01em; }
  .game-line { font-size: 1.15rem; max-width: 30ch; }
  .game-foot { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem 1.4rem; font: 600 0.75rem var(--font-mono); letter-spacing: var(--tracking-label); text-transform: uppercase; }
  .game-go { border-bottom: 1px solid var(--fg-3); padding-bottom: 4px; }
  .game-card:hover .game-go { border-color: var(--signal); }
  .status-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--fg); }

  .lab { margin-top: 5rem; display: grid; gap: 1.6rem; }
  .lab-head { display: grid; gap: 0.8rem; }
  .lab-film { margin: 0; max-width: 32ch; font: 700 clamp(1.3rem, 2.4vw, 2rem)/1.25 var(--font-display); font-stretch: 108%; }
  .lab-grid { list-style: none; margin: 0.6rem 0 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; }
  .lab-card {
    height: 100%; display: grid; gap: 0.6rem; align-content: start; padding: 1.4rem;
    background: var(--surface); text-decoration: none; border: 1px solid transparent;
    transition: border-color 0.3s var(--motion-ease);
  }
  .lab-card:hover { border-color: var(--fg-3); }
  .lab-card:hover .tool-name { text-decoration: underline 1px var(--signal); text-underline-offset: 5px; }
  .tool-name { font: 700 1.2rem var(--font-display); font-stretch: 112%; }
  .tool-line { color: var(--fg-2); font-size: 0.95rem; }

  /* ---------- Road: timeline left, the current year on the right ---------- */
  .road { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: 3rem 5vw; }
  .road-track { position: relative; max-width: 52rem; }
  .road-rail { position: absolute; left: 4px; top: 0; bottom: 0; width: 7px; background: var(--surface); border-radius: 4px; }
  .road-list { list-style: none; margin: 0; padding: 0 0 0 2.6rem; display: grid; gap: 2.4rem; }
  .road-line { position: absolute; left: 7px; top: 0; bottom: 0; width: 1px; background: var(--fg); transform-origin: top; }
  .road-beat { position: relative; display: grid; grid-template-columns: 7rem minmax(0, 1fr); gap: 0.4rem 1.6rem; align-items: baseline; }
  .road-dot { position: absolute; left: calc(-2.6rem + 7px); top: 0.55em; width: 11px; height: 11px; margin-left: -5px; border-radius: 50%; background: var(--fg); }
  .road-beat.now .road-dot { background: var(--signal); }
  .road-dot:global(.flash) { background: var(--signal); }
  .road-when { font: 600 0.78rem var(--font-mono); letter-spacing: 0.14em; text-transform: uppercase; color: var(--fg-3); }
  .road-what { margin: 0; font-size: clamp(1.05rem, 1.5vw, 1.3rem); }
  .road-beat.now .road-what { font-weight: 700; }
  .road-aside { position: relative; }
  .road-now { position: sticky; top: calc(var(--header-h) + 18vh); display: grid; gap: 0.6rem; padding: 2rem; background: var(--surface); }
  .road-year { font: 800 clamp(2.6rem, 4.6vw, 4.8rem)/1 var(--font-display); font-stretch: 112%; letter-spacing: -0.02em; white-space: nowrap; font-variant-numeric: tabular-nums; }
  /* One line icon per stage, stacked; the script shows the one the thread has reached. */
  .road-icons { position: relative; display: block; width: clamp(72px, 7vw, 104px); aspect-ratio: 1; margin-top: 1.4rem; color: var(--fg); }
  .road-icon { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; transform: translateY(6px); transition: opacity 0.35s ease, transform 0.35s ease; }
  .road-icon.on { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) { .road-icon { transition: none; transform: none; } }

  /* ---------- Night shift ---------- */
  .now-panel, .contact-list { margin: 0; display: grid; align-content: start; max-width: 52rem; }
  .now-panel { background: var(--surface); padding: 0.4rem 1.6rem; }
  .now-panel div, .contact-list div { display: grid; grid-template-columns: 11rem minmax(0, 1fr); gap: 1rem; padding-block: 18px; }
  .now-panel div + div { border-top: 1px solid color-mix(in srgb, var(--fg) 12%, transparent); }
  .contact-list div { border-top: 1px solid var(--surface); }
  .contact-list div:last-child { border-bottom: 1px solid var(--surface); }
  .now-panel dt, .contact-list dt { font: 600 0.7rem/1.9 var(--font-mono); letter-spacing: var(--tracking-label); text-transform: uppercase; color: var(--fg-3); }
  .now-panel dt { color: var(--fg-2); }
  .now-panel dd, .contact-list dd { margin: 0; overflow-wrap: anywhere; font-size: 1.1rem; }
  .now-panel a, .contact-list a { text-decoration: none; }
  .now-panel a:hover, .contact-list a:hover { text-decoration: underline; text-decoration-color: var(--signal); }
  .muted { color: var(--fg-2); font-size: 0.9rem; }
  .clock { font: 600 1.1rem var(--font-mono); font-variant-numeric: tabular-nums; }
  .shift { font: 600 0.7rem var(--font-mono); letter-spacing: var(--tracking-label); text-transform: uppercase; color: var(--fg-2); margin-left: 0.8rem; display: inline-flex; align-items: center; gap: 0.5rem; }
  /* The live dot: always there, lime and pulsing only while the night shift is on. */
  .shift:not(:empty)::before { content: ''; width: 8px; height: 8px; border-radius: 50%; background: var(--fg-3); }
  .shift:global(.on)::before { background: var(--signal); animation: pulse 2s ease-in-out infinite; }
  @keyframes pulse { 0%, 100% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--signal) 50%, transparent); } 60% { box-shadow: 0 0 0 7px transparent; } }
  @media (prefers-reduced-motion: reduce) { .shift:global(.on)::before { animation: none; } }

  /* ---------- Contact ---------- */
  .contact { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 3rem 8vw; }
  .contact-main { display: grid; gap: 1.2rem; align-content: start; }
  .contact-lede { margin: 0; max-width: 40ch; font-size: 1.15rem; }
  .contact-lede .link { display: inline-block; margin-top: 1.2rem; }
  .signup { display: grid; gap: 0.6rem; max-width: 30rem; }
  .signup label { font: 600 0.7rem var(--font-mono); letter-spacing: var(--tracking-label); text-transform: uppercase; color: var(--fg-3); }
  .signup-row { display: flex; border: 1px solid var(--surface); }
  .signup input { flex: 1; min-width: 0; background: none; border: 0; color: var(--fg); font: 400 1rem var(--font-body); padding: 14px; }
  .signup button { background: var(--fg); color: var(--bg); font: 600 0.75rem var(--font-mono); letter-spacing: var(--tracking-label); text-transform: uppercase; padding: 0 18px; }
  .fine { margin: 0; font-size: 0.85rem; color: var(--fg-3); }
  .contact-list div { grid-template-columns: 6rem minmax(0, 1fr); }

  @media (max-width: 960px) {
    .origin, .founder, .road, .contact, .game-card { grid-template-columns: minmax(0, 1fr); }
    .founder-portrait { position: relative; top: auto; }
    .founder-portrait img { width: 256px; }
    /* The portrait already hangs from the section rule; one thread is enough. */
    .founder .sec-thread { display: none; }
    .lab-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .road-aside { display: none; }
    .origin-mark { justify-items: start; }
    .mark-tile { width: 160px; }
  }
  @media (max-width: 640px) {
    /* Two per row; the odd one out takes the full row, so no cell is ever blank. */
    .facts { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .facts li:last-child:nth-child(odd) { grid-column: 1 / -1; }
  }
  @media (max-width: 560px) {
    .lab-grid { grid-template-columns: minmax(0, 1fr); }
    .road-beat { grid-template-columns: minmax(0, 1fr); }
    .now-panel div { grid-template-columns: minmax(0, 1fr); gap: 0.2rem; }
    .now-panel { padding-inline: 1.1rem; }
  }
</style>
