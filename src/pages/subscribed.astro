---
// Kit sends new subscribers here after the form posts. Double opt-in: nothing is sent until they confirm.
import Base from '../layouts/Base.astro';
import ErrorPage from '../components/ErrorPage.astro';
---

<Base title="Check your inbox | Silent Thread" description="Confirm your subscription to news from Silent Thread." noindex>
  <ErrorPage
    label="Newsletter"
    title="Check your inbox."
    links={[
      { label: 'Back to the studio', href: '/' },
      { label: 'Raccoon Heist', href: '/games/raccoon-heist' },
    ]}
  >
    <p>We sent you an email with a link. Click it to confirm, and you're on the list. Nothing else arrives until you do.</p>
    <p>Not there in a few minutes? Check spam, or sign up again from the home page.</p>
  </ErrorPage>
</Base>
