---
// One devlog post. Production builds only generate published posts; drafts render in `astro dev`.
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import DevlogCover from '../../components/DevlogCover.astro';
import { blogPosting, breadcrumb, founder } from '../../lib/schema';
import { getPosts, postUrl, kicker, formatDate, cover, type Post } from '../../lib/devlog';

export async function getStaticPaths() {
  return (await getPosts()).map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
const { Content } = await render(post);
const { title, description, pubDate, updatedDate, draft, tags } = post.data;
const path = postUrl(post);
const c = cover(post);
const ogImage = c && !c.todo ? c.src : post.data.game === 'raccoon-heist' ? '/og-raccoon-heist.png' : undefined;
// When the cover is also the post's first figure (devlog #2), show it once, in the text.
const showCover = !(c && !c.todo && post.body?.includes(`](${c.src}`));
---

<Base
  title={`${title} | Silent Thread`}
  description={description}
  ogType="article"
  ogImage={ogImage}
  ogImageAlt={c && !c.todo ? c.alt : undefined}
  noindex={draft}
  schema={[
    founder(),
    blogPosting({ path, title, description, published: pubDate, updated: updatedDate, image: ogImage }),
    breadcrumb([{ name: 'Devlog', path: '/devlog' }, { name: title, path }]),
  ]}
>
  <Fragment slot="head">
    {pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}
    {updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
    {tags.map((t) => <meta property="article:tag" content={t} />)}
    <link rel="alternate" type="application/rss+xml" title="Silent Thread devlog" href="/devlog/rss.xml" />
  </Fragment>

  <article class="section post" aria-labelledby="post-title">
    <header class="post-head">
      <p class="label">
        <a href="/devlog">Devlog</a> / {kicker(post)}
        {draft && <span class="draft-chip">Draft, dev preview only</span>}
      </p>
      <h1 id="post-title" class="post-title">{title}</h1>
      <p class="post-date">
        {pubDate ? <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time> : formatDate()}
        {updatedDate && <> · Updated <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time></>}
      </p>
    </header>

    {showCover && <DevlogCover post={post} eager />}

    <div class="post-body">
      <Content />
    </div>

    <footer class="post-foot">
      <a class="link" href="/devlog">All devlog posts</a>
      <a class="link" href="https://x.com/silentthreadhq" rel="me noopener">Follow on X <span aria-hidden="true">↗</span></a>
    </footer>
  </article>
</Base>

<style>
  .post { padding-top: calc(var(--header-h) + 10vh); border-top: 0; max-width: calc(46rem + var(--side-l) + var(--side-r)); margin-inline: auto; }
  .post-head { display: grid; gap: 1.1rem; margin-bottom: 2.4rem; }
  .post-head .label a { color: inherit; text-decoration: none; }
  .post-head .label a:hover { text-decoration: underline 1px var(--signal); text-underline-offset: 4px; }
  .draft-chip { margin-left: 0.8rem; padding: 3px 6px; border: 1px solid var(--fg-3); color: var(--fg-2); letter-spacing: 0.12em; }
  .post-title { margin: 0; font: 800 clamp(2rem, 5vw, 3.6rem)/1 var(--font-display); font-stretch: 118%; letter-spacing: -0.01em; text-wrap: balance; }
  .post-date { margin: 0; font: 600 0.72rem var(--font-mono); letter-spacing: var(--tracking-label); text-transform: uppercase; color: var(--fg-3); }

  /* Rendered Markdown. */
  .post-body { font-size: clamp(1.05rem, 1.3vw, 1.18rem); line-height: 1.7; }
  .post-body :global(p) { margin: 0 0 1.15em; }
  .post-body :global(h2) {
    margin: 2.6em 0 0.8em; font: 800 clamp(1.4rem, 2.6vw, 1.9rem)/1.1 var(--font-display); font-stretch: 115%;
    text-transform: uppercase; letter-spacing: -0.005em;
  }
  .post-body :global(ul) { margin: 0 0 1.3em; padding-left: 1.2em; }
  .post-body :global(li) { margin: 0 0 0.6em; }
  .post-body :global(li::marker) { color: var(--fg-3); }
  .post-body :global(strong) { font-weight: 700; color: var(--fg); }
  .post-body :global(a) { color: inherit; text-decoration: underline 1px var(--fg-3); text-underline-offset: 4px; }
  .post-body :global(a:hover) { text-decoration-color: var(--signal); }

  .post-foot { display: flex; flex-wrap: wrap; gap: 1rem 2rem; margin-top: 3.5rem; padding-top: 2rem; border-top: 1px solid var(--surface); }
</style>
